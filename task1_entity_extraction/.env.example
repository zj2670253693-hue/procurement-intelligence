# ============================================================
# LLM API 配置
# 复制此文件为 .env 并填入你的 API Key
# ============================================================

# 选择 LLM 提供商: qwen 或 deepseek
LLM_PROVIDER=qwen

# ---- Qwen（通义千问）配置 ----
# 在 https://dashscope.console.aliyun.com/ 获取 API Key
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型: qwen-turbo, qwen-plus, qwen-max, qwen-long
QWEN_MODEL=qwen-plus

# ---- DeepSeek 配置 ----
# 在 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选模型: deepseek-chat, deepseek-coder
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# 生成参数（可选）
# ============================================================
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ============================================================
# MySQL 数据库配置
# ============================================================
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=procurement_kg

# ============================================================
# 输出配置（可选）
# ============================================================
OUTPUT_FORMAT=csv
OUTPUT_FILENAME=extraction_results
